{
  "name": "@deepseek-ai/dsh-native-api-app",
  "description": "Native desktop API-only bundle: loopback Host RPC transport, multi-session services, and readiness without browser assets",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/native-api-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-cmdline": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-session-remote-operations": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-native": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-native-events": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-workbench": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-message-feedback": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-file-reference": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-knowledge-wiki": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-file-reference-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-reference": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-stats": "^0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.2.0",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-registry": "^0.1.1-rc.2"
  }
}