node_modules/
.pnpm-store/
.build/
.native-build/
*.log
.DS_Store
/tsconfig.host.tsbuildinfo
/*.tsbuildinfo
*.tsbuildinfo
*.orig
.sessions/
.llm-wiki/
wiki/

# Stale Swift compilation module caches: compiler outputs (.pcm/.swiftmodule/
# .timestamp). Product code and contract tests exclude this prefix by name and
# nothing consumes it as input; a rebuild regenerates it.
/.tmp-swift-module-cache-*/
# Local environment files. Example files (.env.example/.env.template) stay
# trackable - only the real secret-bearing names are guarded.
/.env
/.env.local
/.env.*.local

# Machine-owned state is never part of a fresh source checkout.
.env
.env.*
!.env.example
!.env.template
!.env.sample
.credentials.yaml*
/.dsh/
/Harness/
/profiles/
/.agent-presets/
/skills/
/logs/
/cache/
/llm-deepseek/
/.ark-*
/.anonymous-user-id
/cordis.patch.yml
/SETTINGS.md
.aws/
**/.heygen/credentials*
**/.hyperframes/config.json*
**/.hyperframes/cloudrun-state.json*
**/.codex/auth.json*
**/.media/anon-id*
**/.media/misses.jsonl*
/Knowledge/
/Default Workspace/
/Document References/
/Workbench Drafts/
/sessions/
/storages/
/attachments/
/terminal-sessions/
/settings.yaml*

# Knowledge-project initialization artifacts that a workspace init can drop at
# a repo root; the shipped repo does not consume them (verified 2026-09-16).
/purpose.md
/schema.md

# Generated build outputs are regenerated by the host build (tsc -b project
# references + tsdown). The build is the single writer; vendored lib/ and the
# .agents source dirs that are merely NAMED lib/ stay tracked.
packages/*/*/lib/
apps/*/lib/
