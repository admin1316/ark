exports[`reports a concurrent credential replacement without deleting it or acknowledging live success 1`] = `
{
  "activeReference": "",
  "concurrentCredentialPreserved": true,
  "failure": {
    "code": "credential-rejected",
    "details": {
      "provider": "alpha",
    },
    "message": "provider credential changed before commit",
  },
  "state": {
    "live": false,
    "needsCredential": false,
    "settingsNs": "transaction-fixture",
    "state": "committed-not-live",
  },
}
`;
