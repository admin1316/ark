{
  "name": "@deepseek-ai/dsh-profile-runner",
  "description": "Shared profile lifecycle runner and canonical shipped Agent preset assets for dsh applications",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/profile-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./process-shutdown": {
      "types": "./lib/types/process-shutdown.d.ts",
      "default": "./lib/process-shutdown.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./config/agent-presets/*": "./config/agent-presets/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/process-shutdown.js",
    "config",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-hmr": "workspace:^",
