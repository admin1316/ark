  create_goal: {
    goal: null;
  } | {
    goal: {
      id: string;
      revision: number;
      objective: string;
      phase: "active" | "paused" | "blocked" | "complete";
      roundsStarted: number;
      maxGoalRounds: number;
      blockedReason?: {
        code: string;
        message: string;
      };
    };
    activation: "armed" | "disarmed";
  };
  edit: {
    path: string;
    before: string;
    after: string;
  };
  exit_plan_mode: {
    approved: true;
  };
  followup_task: {
    messageId: string;
    status: "accepted" | "queued";
  };
  get_goal: {
    goal: null;
  } | {
    goal: {
      id: string;
      revision: number;
